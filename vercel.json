{
  "cleanUrls": true,
  "trailingSlash": false,
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/black-alunos/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/black-alunos/css/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    },
    {
      "source": "/black-alunos/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/black-alunos",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/bio",
      "destination": "/black?utm_source=instagram&utm_medium=organico&utm_campaign=sk0826&utm_content=bio",
      "permanent": false
    },
    {
      "source": "/especial-whatsapp",
      "destination": "/black?utm_source=whatsapp&utm_medium=organico&utm_campaign=sk0826&utm_content=grupos-antigos",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/black-alunos", "destination": "/black-alunos/index" },
    { "source": "/black", "destination": "https://lp-black-26-nao-alunos.vercel.app/black" },
    { "source": "/black/(.*)", "destination": "https://lp-black-26-nao-alunos.vercel.app/black/$1" },
    { "source": "/(.*)", "destination": "https://sk0426.vercel.app/$1" }
  ]
}
